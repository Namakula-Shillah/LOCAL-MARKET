import sqlite3
from datetime import datetime

# -----------------------------
# Database Manager
# -----------------------------
class DatabaseManager:
    def __init__(self, db_name="inventory_system.db"):
        self.conn = sqlite3.connect(db_name)
        self.create_tables()

    def create_tables(self):
        cursor = self.conn.cursor()
        cursor.execute("""
        CREATE TABLE IF NOT EXISTS products (
            product_id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            category TEXT,
            price REAL NOT NULL,
            quantity INTEGER DEFAULT 0
        )
        """)
        cursor.execute("""
        CREATE TABLE IF NOT EXISTS sales (
            sale_id INTEGER PRIMARY KEY AUTOINCREMENT,
            product_id INTEGER,
            quantity INTEGER,
            total_amount REAL,
            date TEXT,
            FOREIGN KEY(product_id) REFERENCES products(product_id)
        )
        """)
        self.conn.commit()

    def add_product(self, product):
        cursor = self.conn.cursor()
        cursor.execute("INSERT INTO products VALUES (?, ?, ?, ?, ?)",
                       (product.product_id, product.name, product.category, product.price, product.quantity))
        self.conn.commit()

    def update_stock(self, product_id, qty):
        cursor = self.conn.cursor()
        cursor.execute("UPDATE products SET quantity = quantity + ? WHERE product_id = ?", (qty, product_id))
        self.conn.commit()

    def reduce_stock(self, product_id, qty):
        cursor = self.conn.cursor()
        cursor.execute("SELECT quantity FROM products WHERE product_id = ?", (product_id,))
        current_qty = cursor.fetchone()[0]
        if current_qty >= qty:
            cursor.execute("UPDATE products SET quantity = quantity - ? WHERE product_id = ?", (qty, product_id))
            self.conn.commit()
        else:
            raise ValueError("Insufficient stock")

    def record_sale(self, product_id, qty, total_amount):
        cursor = self.conn.cursor()
        cursor.execute("INSERT INTO sales (product_id, quantity, total_amount, date) VALUES (?, ?, ?, ?)",
                       (product_id, qty, total_amount, datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
        self.conn.commit()

    def get_products(self):
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM products")
        return cursor.fetchall()

    def get_sales(self):
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM sales")
        return cursor.fetchall()

